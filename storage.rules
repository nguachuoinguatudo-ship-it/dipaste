rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // File repository — publik dibaca, upload untuk yang login
    match /repos/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Avatar pengguna
    match /avatars/{uid}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
